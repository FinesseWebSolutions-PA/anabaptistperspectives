{
  "name": "ap-studio-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ap-studio",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ap-studio-media"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
