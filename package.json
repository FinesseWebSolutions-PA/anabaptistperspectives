{
  "name": "anabaptist-perspectives",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prepare:backend && vite build && node scripts/package-react-worker.mjs",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "dev": "vite --host 127.0.0.1 --port 4174",
    "preview": "wrangler dev --config wrangler.preview.jsonc --port 4174",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run typecheck",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.7"
  }
}
